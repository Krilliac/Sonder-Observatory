# Rust/Tauri build output
/target/
# Generated by tauri-build from capabilities/ and plugin manifests
/gen/schemas/
# Placeholder icons are rasterised by build.rs from the same design as
# icons/app-icon.svg when missing. Once the real set from
# `npm run tauri icon src-tauri/icons/app-icon.svg` is committed, replace these
# two lines with `/icons/android/` and `/icons/ios/` (desktop-only shell).
/icons/*
!/icons/app-icon.svg
# Regenerated by build.rs (tauri-build AppManifest)
/permissions/autogenerated/
