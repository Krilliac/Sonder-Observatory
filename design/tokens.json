{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Sonder Observatory design tokens",
  "note": "The base groups are the dark theme; themes.light overrides colours only. Text roles (text, muted, link, textError, textWarning, textSuccess) meet WCAG AA (4.5:1) on background, surface and elevated in both themes, and onAccent does on accent; tests/tokens.test.ts checks this. Graphic colours (primary, cyan, purple, success, warning, error and the track colours) mark shapes, not text.",
  "color": {
    "background": { "$value": "#070B14", "$type": "color" },
    "surface": { "$value": "#0F1726", "$type": "color" },
    "elevated": { "$value": "#162238", "$type": "color" },
    "border": { "$value": "#24334A", "$type": "color" },
    "borderStrong": { "$value": "#3A4D6B", "$type": "color" },
    "primary": { "$value": "#3B82F6", "$type": "color" },
    "cyan": { "$value": "#22D3EE", "$type": "color" },
    "purple": { "$value": "#A855F7", "$type": "color" },
    "success": { "$value": "#10B981", "$type": "color" },
    "warning": { "$value": "#F59E0B", "$type": "color" },
    "error": { "$value": "#EF4444", "$type": "color" },
    "text": { "$value": "#E6EDF7", "$type": "color" },
    "muted": { "$value": "#94A3B8", "$type": "color" },
    "link": { "$value": "#22D3EE", "$type": "color" },
    "textError": { "$value": "#F87171", "$type": "color" },
    "textWarning": { "$value": "#F59E0B", "$type": "color" },
    "textSuccess": { "$value": "#34D399", "$type": "color" },
    "accent": { "$value": "#1D4ED8", "$type": "color" },
    "onAccent": { "$value": "#FFFFFF", "$type": "color" },
    "focus": { "$value": "#60A5FA", "$type": "color" },
    "trackTelemetry": { "$value": "#C0C8D6", "$type": "color" },
    "trackOther": { "$value": "#6B7A90", "$type": "color" },
    "markSelected": { "$value": "#FFFFFF", "$type": "color" }
  },
  "semantic": {
    "token": { "$value": "{color.primary}", "$type": "color" },
    "attention": { "$value": "{color.purple}", "$type": "color" },
    "activation": { "$value": "{color.cyan}", "$type": "color" },
    "healthy": { "$value": "{color.success}", "$type": "color" },
    "warning": { "$value": "{color.warning}", "$type": "color" },
    "error": { "$value": "{color.error}", "$type": "color" }
  },
  "font": {
    "family": {
      "sans": { "$value": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, \"Cascadia Mono\", Consolas, monospace", "$type": "fontFamily" }
    },
    "size": {
      "xs": { "$value": "11px", "$type": "dimension" },
      "sm": { "$value": "12px", "$type": "dimension" },
      "md": { "$value": "14px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" },
      "xl": { "$value": "20px", "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "bold": { "$value": "600", "$type": "fontWeight" }
    }
  },
  "space": {
    "1": { "$value": "2px", "$type": "dimension" },
    "2": { "$value": "4px", "$type": "dimension" },
    "3": { "$value": "6px", "$type": "dimension" },
    "4": { "$value": "8px", "$type": "dimension" },
    "5": { "$value": "12px", "$type": "dimension" },
    "6": { "$value": "16px", "$type": "dimension" },
    "7": { "$value": "24px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "6px", "$type": "dimension" },
    "lg": { "$value": "10px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "themes": {
    "light": {
      "color": {
        "background": { "$value": "#F4F6FA", "$type": "color" },
        "surface": { "$value": "#FFFFFF", "$type": "color" },
        "elevated": { "$value": "#E9EEF5", "$type": "color" },
        "border": { "$value": "#C5CFDC", "$type": "color" },
        "borderStrong": { "$value": "#8795A8", "$type": "color" },
        "primary": { "$value": "#2563EB", "$type": "color" },
        "cyan": { "$value": "#0891B2", "$type": "color" },
        "purple": { "$value": "#9333EA", "$type": "color" },
        "success": { "$value": "#059669", "$type": "color" },
        "warning": { "$value": "#D97706", "$type": "color" },
        "error": { "$value": "#DC2626", "$type": "color" },
        "text": { "$value": "#111827", "$type": "color" },
        "muted": { "$value": "#4B5563", "$type": "color" },
        "link": { "$value": "#0E7490", "$type": "color" },
        "textError": { "$value": "#B91C1C", "$type": "color" },
        "textWarning": { "$value": "#92400E", "$type": "color" },
        "textSuccess": { "$value": "#065F46", "$type": "color" },
        "accent": { "$value": "#1D4ED8", "$type": "color" },
        "onAccent": { "$value": "#FFFFFF", "$type": "color" },
        "focus": { "$value": "#1D4ED8", "$type": "color" },
        "trackTelemetry": { "$value": "#64748B", "$type": "color" },
        "trackOther": { "$value": "#94A3B8", "$type": "color" },
        "markSelected": { "$value": "#111827", "$type": "color" }
      }
    }
  }
}
