{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Sonder Observatory initial concept tokens",
  "note": "Concept values extracted from the initial design board; audit contrast and tune before implementation.",
  "color": {
    "background": { "$value": "#070B14", "$type": "color" },
    "surface": { "$value": "#0F1726", "$type": "color" },
    "elevated": { "$value": "#162238", "$type": "color" },
    "border": { "$value": "#24334A", "$type": "color" },
    "primary": { "$value": "#3B82F6", "$type": "color" },
    "cyan": { "$value": "#22D3EE", "$type": "color" },
    "purple": { "$value": "#A855F7", "$type": "color" },
    "success": { "$value": "#10B981", "$type": "color" },
    "warning": { "$value": "#F59E0B", "$type": "color" },
    "error": { "$value": "#EF4444", "$type": "color" }
  },
  "semantic": {
    "token": { "$value": "{color.primary}", "$type": "color" },
    "attention": { "$value": "{color.purple}", "$type": "color" },
    "activation": { "$value": "{color.cyan}", "$type": "color" },
    "healthy": { "$value": "{color.success}", "$type": "color" },
    "warning": { "$value": "{color.warning}", "$type": "color" },
    "error": { "$value": "{color.error}", "$type": "color" }
  }
}
